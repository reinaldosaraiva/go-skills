#!/usr/bin/env bash
# commit-msg hook wrapper — runs the frr-style lint in --commit-msg mode.
# The lint is resolved RELATIVE TO THIS HOOK (symlinks followed) — no
# hardcoded home (P061-S003). A missing lint fails OPEN (exit 0).
# Exit-code policy: WARN (1) never blocks; only FAIL (2) does.
SCRIPT="$BASH_SOURCE"
while [ -L "$SCRIPT" ]; do
  DIR=$(cd -P "$(dirname "$SCRIPT")" && pwd)
  NEXT=$(readlink "$SCRIPT")
  case "$NEXT" in
    /*) SCRIPT="$NEXT" ;;
    *)  SCRIPT="$DIR/$NEXT" ;;
  esac
done
SKILL_DIR=$(cd -P "$(dirname "$SCRIPT")/.." && pwd)
LINT="$SKILL_DIR/checks/frr-style-lint.sh"
[ -f "$LINT" ] || exit 0
bash "$LINT" --commit-msg "$1"
rc=$?
[ "$rc" -eq 1 ] && exit 0
exit "$rc"
